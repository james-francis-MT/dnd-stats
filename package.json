{
  "name": "dnd-paladin",
  "version": "1.0.0",
  "description": "Paladin stats viewer",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "test": "jest",
    "test-unit": "jest ./src/*"
  },
  "author": "james-francis-mt",
  "license": "ISC",
  "jest": {
    "transform": {
      "^.+\\.ts$": "@swc/jest"
    },
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "supertest": "^7.3.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
